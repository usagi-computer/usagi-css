{
  "name": "usagi.css",
  "version": "0.1.1",
  "files": [
    "dist"
  ],
  "style": "./dist/usagi.css",
  "exports": {
    ".": "./dist/usagi.css",
    "./min": "./dist/usagi.min.css"
  },
  "type": "module",
  "scripts": {
    "vite": "vite",
    "vite:build": "vite build",
    "sass": "sass",
    "sass:dev": "sass styles/:out/ --watch",
    "sass:build": "sass styles/:out/",
    "dev": "concurrently \"pnpm run sass:dev\" \"pnpm run vite\"",
    "release:minify": "pnpm dlx lightningcss-cli --minify --sourcemap dist/usagi.css -o dist/usagi.min.css",
    "release:build": "pnpm run vite:build && pnpm run release:minify"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "sass": "1.99.0",
    "vite": "8.0.12"
  },
  "dependencies": {
    "@fontsource/maple-mono": "5.2.6",
    "@fontsource/noto-sans-symbols-2": "^5.2.8"
  }
}
